# Image d'exécution du banc de code : un seul conteneur pour tous les langages, lancé sans
# réseau, en lecture seule, utilisateur non privilégié. numpy : requis par les tests HumanEval+.
FROM docker.io/library/python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends php-cli nodejs node-typescript rustc ca-certificates \
 && rm -rf /var/lib/apt/lists/* && pip install --no-cache-dir numpy==2.1.3
RUN useradd -m banc
USER banc
WORKDIR /travail
