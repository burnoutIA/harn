--- /dev/null
+++ b/ggml/src/ggml-cuda/fattn-mla.cuh
@@ -0,0 +1,8 @@
+#pragma once
+
+#include "common.cuh"
+
+// RDNA4 decode/verify attention for the absorbed MLA with one KV head (GLM-4.7 Flash: DKQ 576, DV 512,
+// V a view of the first 512 columns of K, 20 Q heads).  See fattn-mla.cu.
+bool ggml_cuda_flash_attn_ext_mla_applies(int cc, const ggml_tensor * dst);
+void ggml_cuda_flash_attn_ext_mla(ggml_backend_cuda_context & ctx, ggml_tensor * dst);
diff --git a/ggml/src/ggml-cuda/fattn.cu b/ggml/src/ggml-cuda/fattn.cu
index 35ae560..61fcb9c 100644
--- a/ggml/src/ggml-cuda/fattn.cu
+++ b/ggml/src/ggml-cuda/fattn.cu
@@ -1,5 +1,6 @@
 #include "common.cuh"
 #include "fattn-common.cuh"
+#include "fattn-mla.cuh"
 #include "fattn-mma-f16.cuh"
 #include "fattn-tile.cuh"
 #include "fattn-vec.cuh"
@@ -961,6 +962,12 @@ thread_local ggml_cuda_fa_had_req ggml_cuda_fa_had;
 
 void ggml_cuda_flash_attn_ext(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
     ggml_cuda_set_device(ctx.device);
+    // RDNA4 absorbed-MLA decode/verify (GLM-4.7 Flash), see fattn-mla.cu.  The op stays a TILE op for the
+    // allocation and support queries: the path needs no F16 staging (K is F16) and accepts a subset of it.
+    if (ggml_cuda_flash_attn_ext_mla_applies(ggml_cuda_info().devices[ggml_cuda_get_device()].cc, dst)) {
+        ggml_cuda_flash_attn_ext_mla(ctx, dst);
+        return;
+    }
     switch (ggml_cuda_get_best_fattn_kernel(ggml_cuda_get_device(), dst)) {
         case BEST_FATTN_KERNEL_NONE:
             GGML_ABORT("fatal error");
-- 
